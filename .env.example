# Buna Investors Group - Customer Web Application
# Environment Configuration

# Backend API base URL (required)
# Example: https://api.bunainvestors.com/api/v1
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Application name (optional, defaults to "Buna Investors Group")
VITE_APP_NAME=Buna Investors Group

# Maximum file upload size in bytes (optional, defaults to 5MB)
VITE_MAX_UPLOAD_SIZE=5242880
